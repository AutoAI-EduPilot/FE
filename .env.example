# API 베이스 URL — 세 가지 모드:
#   1) 같은 도메인 배포(권장, 쿠키 SameSite 이슈 없음): VITE_API_BASE_URL=/api
#   2) 로컬 Spring 직접 호출:                          VITE_API_BASE_URL=http://localhost:8080
#   3) 다른 도메인의 API 직접 호출(CORS 허용 필요):     VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=/api

# 로컬 dev 전용 — VITE_API_BASE_URL=/api일 때 /api 요청을 프록시할 백엔드.
# 기본값은 배포 dev 서버. 로컬 Spring을 쓰려면 http://localhost:8080으로 변경:
VITE_DEV_PROXY_TARGET=https://edu-pilot.duckdns.org
# 브라우저 QA용 mock 백엔드(테스트 픽스처를 dev 서버가 그대로 서빙):
# VITE_DEV_PROXY_TARGET=mock
